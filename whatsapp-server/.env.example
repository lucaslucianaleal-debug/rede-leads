PORT=3001
TZ=America/Sao_Paulo

# Z-API
# Pode ser configurada por clínica em clinics/{clinicId}/config/whatsapp.
# Estas variáveis servem como fallback global.
ZAPI_INSTANCE_ID=seu-instance-id-aqui
ZAPI_TOKEN=seu-token-da-instancia-aqui
ZAPI_CLIENT_TOKEN=seu-client-token-aqui
WEBHOOK_SECRET=seu-webhook-secret-aqui

# Lembretes automáticos de agendamento
REMINDER_AUTOMATION_ENABLED=true
REMINDER_CLINIC_ID=odontocompany-olimpia
REMINDER_INTERVAL_MS=60000
REMINDER_START_DELAY_MS=15000
REMINDER_COOLDOWN_MINUTES=60
REMINDER_BACKEND_URL=http://127.0.0.1:3001
REMINDER_BLOCKED_PHONE=17991040452
